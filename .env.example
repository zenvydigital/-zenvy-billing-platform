# Zenvy Digitals Billing Platform — environment template
# Copy to .env for local runs. NEVER commit a real .env.
# NEVER put real credentials, API keys or patient data in code or files.

# Postgres connection string (Supabase free tier — see PLAN.md for why Supabase).
# Local dev without a DB is fine: the server starts and /health reports db: not-configured.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port Render assigns at runtime (defaults to 3000 locally).
PORT=3000

# App environment: development | production
NODE_ENV=development

# Secret for signing session tokens (generate a long random string; set in Render dashboard).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the deployed app (used in emails/links). Example: https://app.zenvydigitals.online
APP_BASE_URL=http://localhost:3000

# --- Later passes (leave empty until those integrations exist) ---
# Resend (email alert digests) — key added only after the Resend account is confirmed.
RESEND_API_KEY=
# Paddle (subscriptions) — keys added only after the Paddle account is verified.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle environment: sandbox (test) until the account is live.
PADDLE_ENV=sandbox
# Shared secret for the daily sweep endpoint (POST /api/internal/run-daily).
# Generate a long random string; the external scheduler sends it as the x-cron-secret header.
CRON_SECRET=change-me-to-a-long-random-string
# Twilio (Sara payer calls) — added only at deployment, when live calling is connected.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Deepgram + Gemini (Sara voice/brain) — added only when Rza provides keys.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
